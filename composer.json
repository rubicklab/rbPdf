{
    "name": "rubick/rbpdf",
    "description": "Fluent PDF wrapper built on FPDF for the Rubick ecosystem",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "fawno/fpdf": "^1.9",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "kaareln/php-svg-path-data": "^1.0",
        "nesbot/carbon": "^2.67"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "laravel/pint": "^1.29",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Rubick\\RbPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rubick\\RbPdf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:parallel": "paratest -c phpunit.xml.dist --processes=4",
        "test:coverage": "phpunit -c phpunit.xml.dist --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rubick\\RbPdf\\Laravel\\RbPdfServiceProvider"
            ]
        }
    }
}
